# ==========================================
# BIG TASTE RESTAURANT — ENVIRONMENT CONFIGURATION
# ==========================================

# --- SERVER-SIDE SECRETS (Never expose to browser) ---
# JWT_SECRET: Secret key used to sign and verify staff authentication tokens.
JWT_SECRET="replace_with_a_long_random_entropy_secret_key_at_least_32_chars"

# OWNER_INITIAL_PASSWORD: Password used to bootstrap the primary owner account upon initial launch.
OWNER_INITIAL_PASSWORD="ChangeThisPasswordInProduction2026!"

# PORT: Port used by Express server in Node / Docker deployment (defaults to 3000).
PORT=3000

# NODE_ENV: 'development' or 'production'
NODE_ENV="production"

# --- CLIENT PUBLIC VARIABLES (Exposed with VITE_ prefix) ---
# VITE_API_URL: Optional custom API origin if hosting frontend and backend separately.
# Leave empty when deploying full-stack on same origin or using Netlify function redirects.
VITE_API_URL=""

# --- AI STUDIO CLOUD ENVIRONMENT VARIABLES ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
